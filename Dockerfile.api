# Acqui API (Railway service "api"). Build context: the repository root.
# Not built in the Arc Studio sandbox (no registry access there): see docs/RAILWAY.md.
ARG BUN_VERSION=1.3.14

FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:${BUN_VERSION}
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
# Server code and the two shared helper files the config and chain modules import through the "@/" alias.
COPY packages ./packages
COPY apps/api ./apps/api
COPY src/onchain-facts.ts src/onchain-money.ts ./src/
USER bun
EXPOSE 8080
# Railway injects PORT. TRUST_PROXY=true must be set on the service so rate limits see client IPs.
CMD ["bun", "run", "apps/api/src/index.ts"]
