# Acqui API (Northflank combined service "api"). Build context: the repository root. Dockerfile path: /Dockerfile.api
# The repository is one package (no workspaces): the API imports packages/shared and two helper files from src/ by path.
ARG BUN_VERSION=1.3.14

FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:${BUN_VERSION}
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY src/onchain-facts.ts src/onchain-money.ts ./src/
USER bun
EXPOSE 8080
# Exec form: bun is PID 1 and receives SIGTERM directly. The server listens on 0.0.0.0:$PORT and applies migrations at start.
CMD ["bun", "run", "apps/api/src/index.ts"]
