# Cloudflare Pages project (Settings -> Environment variables). Sanitized template.
# Nothing here is a wallet key. PROXY_SHARED_SECRET is a Pages secret and is read only by the /api function.

# Build-time (Production and Preview)
BUN_VERSION=1.3.14
NODE_VERSION=22

# Public address of the site (no trailing slash). Used at build time for the docs page's canonical link, share tags and sitemap.xml.
SITE_URL=https://REPLACE-WITH-YOUR-PAGES-DOMAIN

# Runtime, read by functions/api/[[path]].ts (Production and Preview)
API_ORIGIN=https://REPLACE-WITH-YOUR-NORTHFLANK-API-HOST.code.run   # origin only, HTTPS, no path
PROXY_SHARED_SECRET=                # (secret) same value as on the API

# Only for the direct cross-site mode described in the guide (not recommended). Build-time, public.
# VITE_API_BASE=https://REPLACE-WITH-YOUR-NORTHFLANK-API-HOST.code.run
