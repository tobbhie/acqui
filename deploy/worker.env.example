# Northflank service "worker" (Dockerfile.worker). Run exactly ONE instance. Sanitized template.

NODE_ENV=production
# Optional: private health listener port (default 8081). Do not make it public.
HEALTH_PORT=8081

DATABASE_URL=                       # (secret) same secret group alias as the API

ACQUI_NETWORK=arc-testnet
ARC_RPC_URL=                        # managed Arc RPC, required in production
ARC_RPC_FALLBACK_URLS=              # optional, comma separated
DISTRIBUTOR_ADDRESS=                # same as the API
DISTRIBUTOR_DEPLOY_BLOCK=           # block of the deployment transaction
# Only on the very first start if payments already exist: a block before the oldest unsettled payment
SCANNER_START_BLOCK=

# Two different keys. The attester must be the distributor's immutable attester; the keeper only pays gas.
ATTESTER_PRIVATE_KEY=               # (secret)
KEEPER_PRIVATE_KEY=                 # (secret) small balance only

WEBHOOK_SECRET_ENCRYPTION_KEY=      # (secret) identical to the API

# Optional tuning and alerts
MIN_KEEPER_BALANCE_USDC=2
CURSOR_LAG_ALERT_SECONDS=120
STUCK_SETTLEMENT_ALERT_SECONDS=300
ALERT_WEBHOOK_URL=
RECOVERY_AUTOEXECUTE=true
