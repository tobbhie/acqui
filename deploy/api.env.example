# Northflank service "api" (Dockerfile.api). Sanitized template: put real values in Northflank, never in git.
# Variables marked (secret) belong in a Northflank secret group or as secret runtime variables.

NODE_ENV=production
PORT=8080

# From the Postgres addon via a secret group alias (POSTGRES_URI -> DATABASE_URL). Add ?sslmode=require if the addon uses TLS and the plain URI is refused.
DATABASE_URL=                       # (secret)

# Chain. Only arc-testnet is accepted until mainnet is unlocked in the code.
ACQUI_NETWORK=arc-testnet
ARC_RPC_URL=                        # managed Arc RPC, required in production
DISTRIBUTOR_ADDRESS=                # deployed PaymentDistributor, see docs/DEPLOYMENTS.md
KEEPER_REIMBURSEMENT_USDC=0.02

# Public addresses of the website (Cloudflare Pages). Origins only, no path.
DASHBOARD_BASE_URL=https://acqui.pages.dev
CHECKOUT_BASE_URL=https://acqui.pages.dev
# Optional extra browser origins allowed to call the API (comma separated), e.g. a Pages preview.
CORS_ALLOWED_ORIGINS=

# Google sign-in. The redirect URI goes through the website: https://<pages domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=               # (secret)
GOOGLE_REDIRECT_URI=https://acqui.pages.dev/api/auth/google/callback

# Generate each with: openssl rand -hex 32
SESSION_SECRET=                     # (secret)
API_KEY_PEPPER=                     # (secret)
WEBHOOK_SECRET_ENCRYPTION_KEY=      # (secret) must be identical on the worker
# Must equal PROXY_SHARED_SECRET on Cloudflare Pages
PROXY_SHARED_SECRET=                # (secret)

# Northflank's load balancer sits in front of the API.
TRUST_PROXY=true
# lax when the website forwards /api to the API (recommended). none only for direct cross-site calls (needs production).
COOKIE_SAME_SITE=lax

# Optional: payout address change emails through Oqumail
OQUMAIL_API_KEY=                    # (secret)
# Optional: demo store (see docs/DEMO.md)
DEMO_MERCHANT_API_KEY=              # (secret)
DEMO_WEBHOOK_SECRET=                # (secret)
