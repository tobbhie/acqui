# Acqui environment. Copy to .env and fill in. Never commit .env. Values below are placeholders.

# ---- Shared ----
NODE_ENV=development
# Only arc-testnet is accepted until mainnet is explicitly unlocked.
ACQUI_NETWORK=arc-testnet
DATABASE_URL=postgres://user:password@localhost:5432/acqui
# Managed Arc RPC (required when NODE_ENV=production). Leave blank to use the public fallback.
ARC_RPC_URL=
CHECKOUT_BASE_URL=http://localhost:5173
# Immutable fee recipient Safe. Set after Step 02. Verify the address on the explorer first.
FEE_RECIPIENT_SAFE=
# Decimal USDC cap for keeper reimbursement. No default; decided in Step 02.
KEEPER_REIMBURSEMENT_CAP_USDC=

# ---- API (apps/api) ----
PORT=8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud, e.g. http://localhost:8080/auth/google/callback
GOOGLE_REDIRECT_URI=
# Where the dashboard is served (post-login redirect, CSRF origin check)
DASHBOARD_BASE_URL=
# Deployed PaymentDistributor address. Without it, payment intents are refused.
DISTRIBUTOR_ADDRESS=
# Fixed keeper reimbursement per intent (decimal USDC), at most the contract's immutable cap
KEEPER_REIMBURSEMENT_USDC=
# true only behind a trusted proxy (enables X-Forwarded-For for rate limiting)
TRUST_PROXY=false
# Generate each with: openssl rand -hex 32
SESSION_SECRET=
API_KEY_PEPPER=
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Optional SMTP for payout-address-change confirmation. If incomplete, payout changes stay frozen.
# Oqumail (HTTPS API) needs only its per-mailbox API key. The sender address is already set up in Oqumail.
# EMAIL_PROVIDER is optional: leave empty to use Oqumail when the key is set, or set it to smtp to use SMTP_* below.
EMAIL_PROVIDER=
OQUMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# SMTP only: the From address (Oqumail ignores it)
EMAIL_FROM=

# ---- Demo store (API server only; never exposed to a browser) ----
# The demo merchant's API key and webhook secret. Leave empty to switch the demo store off.
DEMO_MERCHANT_API_KEY=
DEMO_WEBHOOK_SECRET=
# How the demo server reaches this API (default http://127.0.0.1:PORT)
DEMO_API_BASE_URL=

# ---- Frontend (Vite) ----
# Production web server (apps/web): the API's private address, e.g. http://api.railway.internal:8080
API_INTERNAL_URL=
# Browser API prefix (default /api, proxied to the API). In dev, ACQUI_API_PROXY_TARGET points the proxy elsewhere.
VITE_API_BASE=
ACQUI_API_PROXY_TARGET=

# ---- Worker (apps/worker) ----
# Run exactly ONE replica. Needs DATABASE_URL, DISTRIBUTOR_ADDRESS (above) and the keys below.
# Pays gas for settlement and recovery. Keep only a small working balance. Use a secrets manager in production.
KEEPER_PRIVATE_KEY=
# Signs settlement attestations; must be the distributor's immutable attester. Never reuse the keeper key.
ATTESTER_PRIVATE_KEY=
# Comma separated backup RPC URLs (the primary is ARC_RPC_URL)
ARC_RPC_FALLBACK_URLS=
# Required on the first run when payments already exist: a block before the oldest unsettled payment
SCANNER_START_BLOCK=
# Block the distributor was deployed in (from its deployment transaction)
DISTRIBUTOR_DEPLOY_BLOCK=
SCAN_INTERVAL_MS=10000
KEEPER_INTERVAL_MS=3000
RECONCILE_INTERVAL_MS=15000
SCAN_MAX_BLOCKS=500
REPLAY_OVERLAP_BLOCKS=5
CONFIRMATIONS=1
MAX_FEE_PER_GAS_GWEI=200
MIN_KEEPER_BALANCE_USDC=2
CURSOR_LAG_ALERT_SECONDS=120
STUCK_SETTLEMENT_ALERT_SECONDS=300
# Optional: receives alerts as JSON POSTs
ALERT_WEBHOOK_URL=
RECOVERY_AUTOEXECUTE=true
HEALTH_PORT=8081

# ---- Integration script (testnet only, throwaway keys, never mainnet) ----
# Local runs need none of these: `bun run integration:settle -- --local`
RPC_URL=
INTEGRATION_DEPLOYER_KEY=
INTEGRATION_ATTESTER_KEY=
INTEGRATION_CUSTOMER_KEY=
INTEGRATION_KEEPER_KEY=
INTEGRATION_MERCHANT_ADDRESS=
INTEGRATION_FEE_SAFE_ADDRESS=
