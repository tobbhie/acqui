# Acqui worker (Railway service "worker"). Run exactly ONE replica. Build context: the repository root.
ARG BUN_VERSION=1.3.14

FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:${BUN_VERSION}
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY packages ./packages
# The worker reuses the API's database, state-machine and URL modules.
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY src/onchain-facts.ts src/onchain-money.ts ./src/
USER bun
EXPOSE 8081
# Railway injects PORT, which the worker's /health endpoint uses.
CMD ["bun", "run", "apps/worker/src/index.ts"]
