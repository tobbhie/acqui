# Acqui worker (Northflank combined service "worker"): scanner, attester and keeper loops. Run exactly ONE instance.
# Build context: the repository root. Dockerfile path: /Dockerfile.worker
ARG BUN_VERSION=1.3.14

FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:${BUN_VERSION}
WORKDIR /app
ENV NODE_ENV=production
ENV HEALTH_PORT=8081
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY packages ./packages
# The worker reuses the API's database, state-machine and URL modules.
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY src/onchain-facts.ts src/onchain-money.ts ./src/
USER bun
# Internal health listener only (do not give it a public port). Exec form: bun is PID 1 and receives SIGTERM directly.
EXPOSE 8081
CMD ["bun", "run", "apps/worker/src/index.ts"]
